# Backend al que el servidor de desarrollo reenvía /api (sin CORS en desarrollo).
VITE_API_PROXY=http://localhost:8000

# En producción, déjalo vacío si el frontend y la API se sirven desde el mismo dominio
# (recomendado: la cookie de sesión es SameSite=Strict). Si la API está en otro dominio del
# mismo sitio, pon su URL completa, por ejemplo https://api.elmexicano.bo
VITE_API_BASE_URL=
